# Public backend URL for the production build (Vercel).
# Vite inlines VITE_* variables into the bundle at build time — no Vercel
# dashboard env-vars needed. This URL is not a secret: it is visible in the
# deployed JS bundle regardless, and the backend's CORS allowlist
# (render.yaml -> CORS_ORIGINS) is the actual access control.
VITE_API_URL=https://trackshield-ai-api.onrender.com
